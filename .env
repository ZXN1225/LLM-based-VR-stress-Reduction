# Copy to .env; fill only the providers used. Never commit real credentials.
LLM_MODEL=gpt-5.4
# May use a separate tool-capable coordinator after validating its decisions.
# Leave unset to use the model selected in the UI for coordination as well.
# AGENT_MODEL=gpt-5.4
# LLM_MODELS=gpt-5.4,gpt-5.4-mini
OPENAI_API_KEY=
CHROMA_OPENAI_API_KEY=
SUNO_API_KEY=
SUNO_API_BASE=
HF_TOKEN=
# Optional alternate provider keys inherited from the original project:
CLAUDE_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
API_KEY=

APP_HOST=127.0.0.1
APP_PORT=8000
AGENT_MAX_TURNS=64
AGENT_MAX_CALLS=96
AGENT_MAX_OUTPUT_TOKENS=1800
MAX_AUDIT_RETRIES=3
AUTO_RUN_UPSCALE=1

# Provider-specific, disabled by default. Enable only on a verified compatible route.
# This is a routing hint for prompt-prefix reuse, NOT an application response cache.
# AGENT_PROMPT_CACHE_KEY=vr-tools-v1
# Keep RESULTS_ROOT under static for public_static_url compatibility.
# RESULTS_ROOT=static/results
# SESSION_LOG_JSONL=static/results/session_logs.jsonl
# GPU_LOCK_FILE=/a/path/shared/by/all/processes/gpu.lock

# Existing image-pipeline settings remain supported.
# Optional examples below use code defaults, NOT values from a private .env.
# Keep your previously tuned values; do not replace your .env wholesale.

# Image generation, panorama handling and seam refinement
# ENABLE_LATENT_CIRCULAR_PADDING=1
# SEAM_USE_LATENT_CIRCULAR_PADDING=0
# PHOTO_FINISHER_SCALE: uses a code-defined fallback; preserve your existing setting.
# PROGRESSIVE_HIRES_ENABLED=1
# PROGRESSIVE_HIRES_STAGES=2048x1024,3072x1536
# PROGRESSIVE_HIRES_STEPS=20
# PROGRESSIVE_HIRES_STRENGTHS=0.40,0.28
# PROGRESSIVE_HIRES_GUIDANCE_SCALE=5.0
# PROGRESSIVE_HIRES_CONTROLNET_SCALE=0.15
# PROGRESSIVE_HIRES_USE_IP_ADAPTER=1
# SEAM_REFINER_ENABLED=1
# SEAM_REFINE_STEPS=8
# SEAM_REFINE_STRENGTH=0.28
# SEAM_MOVE_GENERATION_TO_CPU=1
# SEAM_REFINE_MASK_BLUR=20
# AUTO_UPSCALE_SCALE: uses a code-defined fallback; preserve your existing setting.
# GENERATION_BASE_WIDTH=1536
# GENERATION_BASE_HEIGHT=768
# SEAM_REFINE_MASK_RATIO=0.15
# GENERATION_CONTROLNET_SCALE=0.25
# GENERATION_STEPS=36
# GENERATION_GUIDANCE_SCALE=6.0
# GENERATION_PIPE_DEVICE_MODE=swap
# CIRCULAR_PADDING_VERTICAL_MODE=constant
# PANORAMA_CIRCULAR_MODULES=unet,controlnet,vae
# SEAM_REFINER_DEVICE_MODE=swap
# SEAM_REFINE_DTYPE=bf16

# Final image enhancement
# PHOTO_FINISHER_RESIZE=lanczos
# PHOTO_FINISHER_ENABLED=1
# PHOTO_FINISHER_TARGET_WIDTH=4096
# PHOTO_FINISHER_TARGET_HEIGHT=2048
# PHOTO_FINISHER_DENOISE=0
# PHOTO_FINISHER_DENOISE_H=1.2
# PHOTO_FINISHER_DENOISE_H_COLOR=1.2
# PHOTO_FINISHER_CLAHE=1
# PHOTO_FINISHER_CLAHE_CLIP=1.35
# PHOTO_FINISHER_CLAHE_TILE=8
# PHOTO_FINISHER_SHARPEN=1
# PHOTO_FINISHER_SHARPEN_RADIUS=1.15
# PHOTO_FINISHER_SHARPEN_AMOUNT=0.40
# PHOTO_FINISHER_SHARPEN_THRESHOLD=3
# PHOTO_FINISHER_LOCAL_CONTRAST=1
# PHOTO_FINISHER_LOCAL_CONTRAST_AMOUNT=0.025
# PHOTO_FINISHER_SATURATION_SCALE=1.0
# PHOTO_FINISHER_PNG_COMPRESSION=1
# PHOTO_FINISHER_DEBUG=0

# Legacy names not read by the supplied source (listed for migration only):
# PROGRESSIVE_HIRES_LATENT_GUIDED
# PROGRESSIVE_HIRES_SCHEDULER
# ENABLE_VAE_TILING
# VAE tiling is enabled directly in the pipeline, not through ENABLE_VAE_TILING.
